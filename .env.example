# Enprato production environment template. Values are intentionally blank. Configure on the server only.
ENPRATO_DATABASE_PATH= # SQLite path outside the Git checkout
ENPRATO_COOKIE_SECURE= # set 1 behind HTTPS
ENPRATO_CORS_ORIGINS= # comma-separated exact origins, e.g. the formal HTTPS domain
ENPRATO_ALLOW_MOCK_PAY= # must remain 0/unset in production
ENPRATO_ENABLE_DEV_MEMBERSHIP= # must remain 0/unset in production
ENPRATO_ENABLE_CURATED= # set 1 on Tencent Cloud only to show VOA recommended lessons
ENPRATO_REQUIRE_AUTH= # set 1 on Tencent Cloud to require login; leave unset for local anonymous use
WECHAT_WEB_APP_ID= # 微信开放平台「网站应用」AppID，PC 扫码登录
WECHAT_WEB_APP_SECRET= # 网站应用 AppSecret，只放服务器
WECHAT_OA_APP_ID= # 已认证服务号 AppID，微信内置浏览器网页授权
WECHAT_OA_APP_SECRET= # 服务号 AppSecret，只放服务器；不要与微信支付混用同一套身份逻辑
WECHAT_OAUTH_REDIRECT_URI= # https://enprato.site/api/auth/wechat/callback
ENPRATO_SMS_PROVIDER= # production: tencent ；local tests may use dev
ENPRATO_ALLOW_DEV_SMS= # must remain 0/unset in production
ENPRATO_ENV= # production on Tencent Cloud
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION= # default ap-guangzhou
ENPRATO_LICENSE_SECRET= # random server-only value if legacy license compatibility remains
ENPRATO_PAY_MONTHLY_URL= # legacy manual payment URL; leave unset for real provider flow
ENPRATO_PAY_LIFETIME_URL= # legacy manual payment URL; leave unset
FFMPEG_PATH= # optional ffmpeg executable path
YT_DLP_PATH= # optional yt-dlp executable path
ENPRATO_COOKIES= # optional yt-dlp cookies file path
WHISPER_MODEL= # default small.en
WHISPER_DEVICE= # default cuda
WHISPER_COMPUTE= # default float16
DASHSCOPE_API_KEY= # server-only DashScope/Bailian key. Never commit a real value.
DASHSCOPE_LANGUAGE_HINTS= # default auto (zh,en). Comma-separated hints, not an English-only lock.
ENPRATO_ASR_BACKEND= # auto | aliyun | whisper

# WeChat Pay API v3. Fill only after merchant credentials and HTTPS callback are ready.
WECHATPAY_MCH_ID= # merchant id, fill on server only
WECHATPAY_APP_ID=
WECHATPAY_MERCHANT_SERIAL_NO= # certificate serial, fill on server only
WECHATPAY_PUBLIC_KEY_ID= # public key id, fill on server only
WECHATPAY_PRIVATE_KEY_PATH= # server filesystem path, never commit the file
WECHATPAY_PUBLIC_KEY_PATH= # server filesystem path, never commit the file
WECHATPAY_API_V3_KEY= # 32-byte server-only key
WECHATPAY_NOTIFY_URL=

# Per-source-IP in-memory payment limits; configure behind a shared limiter for multiple workers.
ENPRATO_PAYMENT_RATE_LIMIT= # default 10
ENPRATO_PAYMENT_RATE_WINDOW= # default 60 seconds

# Backup script variables (server shell only)
ENPRATO_DATA_DIR= # default /home/ubuntu/enprato-data
ENPRATO_BACKUP_DIR= # default /var/backups/enprato

# Optional frontend build variables
VITE_UPDATE_MANIFEST_URL= # optional update manifest
VITE_ENABLE_SERVER_SPEAKER= # keep unset for browser audio
