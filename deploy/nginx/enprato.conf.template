# Copy to /etc/nginx/sites-available/enprato only after replacing placeholders.
# This template is not applied automatically.
server {
    listen 80;
    listen [::]:80;
    server_name enprato.site www.enprato.site;
    return 301 https://enprato.site$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name enprato.site www.enprato.site;

    ssl_certificate /etc/letsencrypt/live/enprato.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/enprato.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/enprato;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:18787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 512m;
    }

    location = /api/payments/wechat/notify {
        proxy_pass http://127.0.0.1:18787/api/payments/wechat/notify;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 1m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
