# Install as /etc/enprato/enprato.env with chmod 600. Keep every value server-side.
ENPRATO_DATABASE_PATH=
ENPRATO_COOKIE_SECURE=1
ENPRATO_CORS_ORIGINS=https://enprato.site
ENPRATO_ALLOW_MOCK_PAY=0
ENPRATO_ENABLE_DEV_MEMBERSHIP=0
# 云端首页展示 VOA 等推荐课；本机不要设此项
ENPRATO_ENABLE_CURATED=1
# 云端强制登录；本机不要设此项，可匿名用 license
ENPRATO_REQUIRE_AUTH=1
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=https://enprato.site/api/auth/wechat/callback
ENPRATO_SMS_PROVIDER=
ENPRATO_ALLOW_DEV_SMS=0
ENPRATO_ENV=production
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
ENPRATO_LICENSE_SECRET=
FFMPEG_PATH=
YT_DLP_PATH=
ENPRATO_COOKIES=
WHISPER_MODEL=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
ENPRATO_PAYMENT_RATE_LIMIT=10
ENPRATO_PAYMENT_RATE_WINDOW=60
WECHATPAY_MCH_ID=
WECHATPAY_APP_ID=
WECHATPAY_MERCHANT_SERIAL_NO=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PRIVATE_KEY_PATH=
WECHATPAY_PUBLIC_KEY_PATH=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=
